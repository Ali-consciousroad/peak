# ===========================================
# FREELANCE MARKETPLACE - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your actual values
# Never commit your actual .env file to version control

# ===========================================
# AUTHENTICATION (Clerk)
# ===========================================
# Get these from your Clerk dashboard: https://dashboard.clerk.com/
CLERK_SECRET_KEY="sk_test_your_secret_key_here"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Local PostgreSQL database (recommended for development)
DATABASE_URL="postgresql://username:password@localhost:5432/freelance_marketplace"

# Alternative: Remote PostgreSQL database
# DATABASE_URL="postgresql://username:password@your-db-host:5432/database_name"

# Prisma Accelerate (optional - for production caching)
# PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key_here"

# Legacy PostgreSQL URL (if using older connection format)
# POSTGRES_URL="postgres://username:password@host:port/database"

# ===========================================
# SUPPORT / BUY ME A COFFEE (Optional)
# ===========================================
# Your Buy Me a Coffee page URL for the Support link in navbar and footer
# Example: https://buymeacoffee.com/mcfly21
# NEXT_PUBLIC_SUPPORT_URL="https://buymeacoffee.com/mcfly21"

# ===========================================
# DEVELOPMENT TOOLS
# ===========================================
# Nx daemon for faster builds (set to "false" if experiencing issues)
NX_DAEMON="false"

# ===========================================
# CHATBOT (Optional - Ollama or OpenAI-compatible)
# ===========================================
# Start Ollama first: open the Ollama app (macOS/Windows) or run: ollama serve
# Default behavior is rules-only. Set CHATBOT_MODE to enable LLM usage.
# Modes:
# - rules: keyword-based FAQ only
# - llm: always use LLM (error if LLM fails)
# - hybrid: try LLM, fallback to rules on failure
CHATBOT_MODE="hybrid"

# OpenAI-compatible base URL (Ollama example)
CHATBOT_OPENAI_BASE_URL="http://localhost:11434"
# Example Ollama model
CHATBOT_OPENAI_MODEL="llama3.1:8b"
# Optional for hosted APIs; not required for local Ollama
# CHATBOT_OPENAI_API_KEY="your_api_key_here"

# ===========================================
# TURBO CONFIGURATION (Optional)
# ===========================================
# Turbo cache settings for faster builds
TURBO_CACHE="remote:rw"
TURBO_DOWNLOAD_LOCAL_ENABLED="true"
TURBO_REMOTE_ONLY="true"
TURBO_RUN_SUMMARY="true"

# ===========================================
# VERCEL DEPLOYMENT (Auto-generated by Vercel)
# ===========================================
# These are automatically set by Vercel during deployment
# Do not manually set these in your local .env file
# VERCEL="1"
# VERCEL_ENV="production"
# VERCEL_GIT_COMMIT_AUTHOR_LOGIN=""
# VERCEL_GIT_COMMIT_AUTHOR_NAME=""
# VERCEL_GIT_COMMIT_MESSAGE=""
# VERCEL_GIT_COMMIT_REF=""
# VERCEL_GIT_COMMIT_SHA=""
# VERCEL_GIT_PREVIOUS_SHA=""
# VERCEL_GIT_PROVIDER=""
# VERCEL_GIT_PULL_REQUEST_ID=""
# VERCEL_GIT_REPO_ID=""
# VERCEL_GIT_REPO_OWNER=""
# VERCEL_GIT_REPO_SLUG=""
# VERCEL_OIDC_TOKEN=""
# VERCEL_TARGET_ENV="production"
# VERCEL_URL=""

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Set up your PostgreSQL database locally or use a cloud provider
# 3. Get your Clerk keys from https://dashboard.clerk.com/
# 4. Update the DATABASE_URL with your actual database credentials
# 5. Run: npx prisma db push (to sync your database schema)
# 6. Run: npx prisma generate (to generate the Prisma client)
# 7. Start your development server: npm run dev

# ===========================================
# DATABASE SETUP COMMANDS
# ===========================================
# Create local PostgreSQL database:
# createdb freelance_marketplace
# 
# Or using psql:
# psql -c "CREATE DATABASE freelance_marketplace;"
#
# Apply database migrations:
# npx prisma migrate dev
#
# Seed the database with initial data:
# npx prisma db seed
